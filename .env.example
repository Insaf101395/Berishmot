# Скопируйте в .env и заполните своими значениями
BOT_TOKEN=
MAIN_CHANNEL=@your_channel
ANTHROPIC_API_KEY=
IMGBB_KEY=
VK_GROUP_ID=
SESSION_SECRET=
# Домен, по которому VK берёт фид и фото (напр. https://img.berishmot.store)
PUBLIC_URL=https://img.berishmot.store
PORT=8080
# Папка локального хранилища (фото VK, партии). Оставьте по умолчанию.
STORAGE_DIR=storage_data
# НЕ ставьте DISABLE_BOT_POLLING на сервере — иначе бот не отвечает.
