run = "python3 main.py"

[nix]
channel = "stable-24_05"

[env]
PYTHONUNBUFFERED = "1"          # чтобы логи сразу выводились
PORT = "5000"                   # если нужен веб-сервер (для бота не обязательно)

hidden = [".config", ".git", "node_modules", "dist"]

# Установка пакетов — через poetry/pyproject.toml или requirements.txt
# НЕ пиши pip install здесь — используй replit.nix или shell.nix для nix-пакетов
